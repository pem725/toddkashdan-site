---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Contact Todd Kashdan">
  <div class="wrap page-hero">
    <p class="kicker">Get in touch</p>
    <h1>Questions? Speaking requests? <em>Beefs?</em></h1>
  </div>

  <div class="section wrap">
    <div class="grid3">
      <div class="panel">
        <h3>General questions</h3>
        <p>Please email Todd directly.</p>
        <a href="mailto:todd@toddkashdan.com">todd@toddkashdan.com</a>
      </div>
      <div class="panel">
        <h3>Speaking engagements</h3>
        <p>Email Todd directly, or contact his agency.</p>
        <a href="mailto:todd@toddkashdan.com">Email Todd</a> &middot; <a href="#">The Lavin Agency</a>
      </div>
      <div class="panel">
        <h3>Well-Being Lab</h3>
        <p>George Mason University<br />Mail Stop 3F5<br />Fairfax, VA 22030</p>
      </div>
    </div>
  </div>

  <div class="section wrap">
    <div class="sec-h"><h2>Follow along</h2></div>
    <div style="display:flex; gap:22px; flex-wrap:wrap;">
      <a class="btn ghost" href="#">Twitter</a>
      <a class="btn ghost" href="#">Instagram</a>
      <a class="btn ghost" href="#">Facebook</a>
      <a class="btn ghost" href="#">LinkedIn</a>
    </div>
  </div>
</Layout>
