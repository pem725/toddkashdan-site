---
import "../styles/site.css";

interface Props {
  title: string;
  current?: "home" | "well-being-lab" | "speaking" | "provoked" | "about";
}

const { title, current } = Astro.props;

const nav = [
  { href: "/well-being-lab/", label: "Well-Being Lab", key: "well-being-lab" },
  { href: "/speaking/", label: "Speaking", key: "speaking" },
  { href: "/provoked/", label: "Provoked", key: "provoked" },
  { href: "/about/", label: "About Todd", key: "about" },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
</head>
<body>
  <div class="page">
    <nav class="nav">
      <a class="brand" href="/">TODD<span>.</span>KASHDAN</a>
      {nav.map((item) => (
        <a href={item.href} class={current === item.key ? "current" : ""}>{item.label}</a>
      ))}
    </nav>

    <slot />

    <div class="foot">
      <span>&copy; Todd Kashdan</span>
      <a href="mailto:todd@toddkashdan.com">todd@toddkashdan.com</a>
      <a href="/provoked/">Provoked</a>
      <a href="/well-being-lab/">Well-Being Lab</a>
    </div>
  </div>
</body>
</html>
